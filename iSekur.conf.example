# iSekur config: copy to ~/.config/isekur/isekur.conf
# Lines starting with # or ; are comments.

[general]
nick      = mynick
altnick   = mynick_
realname  = iSekur user
theme     = default          ; themes/<name>.theme (also ~/.config/isekur/themes/)
timestamp = %H:%M
colors    = auto             ; auto (truecolor if $COLORTERM says so) | truecolor | 256
mouse     = on               ; click tabs/nicks, wheel scrolls; F3 toggles, Shift+drag selects text
; ignore  = spammer!*@* *!*@*.bad.host   ; or use /ignore and /save

# Flood control: lines sent at once, then one every N ms (0 = no limit).
flood_burst       = 5
flood_interval_ms = 2000

# Chat logs: channels and queries go to <log_dir>/<server>/<name>.log
# (private files, formatting stripped). Any of these can also be set per server.
log       = off
; log_dir = ~/irclogs        ; default: "logs" next to this file
log_history = 200            ; lines restored into a tab from its log (0 = off)
log_rotate  = on             ; start a new file each day; old ones become <name>.YYYY-MM-DD.log

# Copy highlights and private messages to window 1 ("what did I miss").
hilight_window = on

# Ask before sending a paste longer than this many lines (0 = never ask).
paste_confirm = 5

# Mark yourself away when nobody is attached for 30s (--daemon with no browser
# open), or after auto_away_idle minutes without typing (0 = only when detached).
# Typing anything brings you back; a manual /away is left alone.
auto_away      = on
auto_away_idle = 0
away_message   = Not here right now

# On join, fetch what was said since the last line you have, from servers with
# IRCv3 chathistory (max 500, 0 = off).
history_fetch = 100

# CTCP answers (at most one reply every 2s per server, against floods).
# VERSION says e.g. "iSekur 0.2 :: Linux 6.8.0/x86_64 :: ... :: <github link>".
ctcp_version = on
ctcp_time    = on
ctcp_ping    = on

# One [server.<name>] section per network. All of them connect at startup
# unless autoconnect = false.
[server.sekurnet]
host      = irc.sekurnet.org
port      = 6697
tls       = true
tls_verify = true            ; false only for self-signed test servers
autojoin  = #isekur-test
; sasl_user = mynick
; sasl_pass = secret
; sasl_mech = PLAIN          ; PLAIN | SCRAM-SHA-256 | EXTERNAL (default: PLAIN, or EXTERNAL with cert)
; cert      = /path/client.pem  ; client certificate for SASL EXTERNAL / CertFP
; password  = server-password

[server.local]
host      = 127.0.0.1
port      = 6667
autoconnect = false

# Built-in webchat: open the same session from a browser.
# HTTPS is mandatory unless bound to localhost; without cert/key a self-signed
# certificate is generated next to this file on first run.
# autostart = off (default): start it when needed with /web start, or launch
# with --web; /web stop turns it off. --daemon always starts it.
[web]
autostart     = off
bind          = 127.0.0.1
port          = 8443
user          = me
password_hash =              ; run: isekur --hash-password
; cert = /path/fullchain.pem
; key  = /path/privkey.pem

# Key bindings: <action> = <key> [key...]
# Keys: M-x (Alt), C-x (Ctrl), F1-F12, PgUp, PgDn, Left/Right/Up/Down (M-Right...).
# Actions: next_tab prev_tab next_active next_server close_tab scroll_up
#          scroll_down toggle_nicklist tab_1 .. tab_10
[keys]
; next_tab = M-Right C-n
; toggle_nicklist = F2
