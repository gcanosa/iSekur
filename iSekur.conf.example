# iSekur config: copy to ~/.config/isekur/isekur.conf
# Lines starting with # or ; are comments.

[general]
nick      = mynick
altnick   = mynick_
realname  = iSekur user
; user      = mynick         ; the ident (user@) part; default: the nick
theme     = default          ; themes/<name>.theme (also ~/.config/isekur/themes/)
theme_dir = themes           ; where themes are looked for first, e.g. ~/mythemes
web_font      = theme      ; webchat font: theme (its font, else mono) | mono | sans | serif
web_font_size = 14         ; webchat text size in px
web_tree_lines = off       ; on: faint ├ └ lines join the webchat's channels to their network
web_tree_width = 220       ; the webchat's tab list width in px (120-600)
web_unread_badge = on      ; off: no count of unread messages next to the webchat's tabs
timestamp =                  ; e.g. %H:%M:%S (empty: the theme's, [%H:%M] in mirc)
nick_width =                 ; nick column, longer nicks are cut (empty: the theme's, 12; 0: no column, mirc style)
timestamp_align = left      ; left | right (the right edge of the chat, terminal and webchat)
timestamp_hover = off       ; on: the webchat hides the time, it fades in under the mouse and out slowly
scrollback = 2000           ; lines kept in memory per tab (min 100); fewer = less memory
colors    = auto             ; auto (truecolor if $COLORTERM says so) | truecolor | 256
mouse     = on               ; click tabs/nicks, wheel scrolls, drag copies; F3 toggles
show_guide = on              ; open the first steps guide (/guide) at startup

# Flood control: lines sent at once, then one every N ms (0 = no limit).
flood_burst       = 5
flood_interval_ms = 2000

# Chat logs: channels and queries go to <log_dir>/<server>/<name>.log
# (private files, formatting stripped). Any of these can also be set per server.
log       = off
log_dir   =                  ; default: "logs" next to this file, e.g. ~/irclogs
log_history = 200            ; lines restored into a tab from its log (0 = off)
log_rotate  = on             ; start a new file each day; old ones become <name>.YYYY-MM-DD.log
keep_history = on            ; log off: tabs still show their last log_history lines after a restart
                             ; (kept in <config>.history, e.g. isekur.history; private, overwritten)

# Copy highlights and private messages to window 1 ("what did I miss").
hilight_window = on

# What you leave with (/quit and /part without text). Empty: "iSekur IRC <version>".
# Can be set per server too.
quit_message =
part_message =

# Join a channel again right after being kicked from it (with its autojoin key). Per server too.
rejoin_on_kick = off

# The iSekur banner at startup: in the theme's colors, or white and gray.
banner_mono = off
# A light sweeps across it once when iSekur starts in a terminal (not with banner_mono).
banner_anim = on

# Once a day, ask github.com for the latest iSekur release; a newer one shows in /about
# and lights the webchat's ⓘ. The request carries nothing about you.
check_updates = on

# Right of the status bar: up (iSekur's uptime), cpu (this machine's CPU %),
# mem (memory free/total), load (load average), bat (battery, laptops only).
# Or /statusbar cpu on and /save.
status_info = up
# When cpu and mem catch the eye: "min avg max" percents (memory: % in use).
# At min the value turns yellow, at avg orange, at max red.
cpu_levels = 50 75 90
mem_levels = 70 85 95

# Other people's messages type themselves out, letter by letter (/typing toggles it).
typing_effect = off

# Ring the terminal bell for private messages, mentions of your nick and
# invites (most terminals then flash, bounce the dock icon or play a sound).
bell_notifications = on

# /exec: shell commands are killed after this many seconds (0 = never). The
# webchat can't run them unless exec_web = on (anyone logged in to it could).
exec_timeout = 30
exec_web     = off

# A named pipe (weechat's fifo): with fifo = on, a line written to it runs as if
# typed in the active tab, e.g. echo "/msg bob hi" > ~/.config/isekur/fifo. It is
# created when turned on and removed when turned off or at exit. Owner-only (0600),
# dropped while locked. \n ends a line, \xHH is any byte (\x03 color), \e the escape,
# \\ a backslash, \b bold \i italics \u underline \s strike \m mono \v reverse \o reset.
# "net/#chan|text" or "net|/cmd" or "3|text" (tab 3) sends to that tab; no tab, the active one.
# Not on native Windows (no named pipes).
# fifo_path empty: <name>.fifo beside this config (isekur.conf: "fifo" in its folder),
# so each iSekur running from its own config has its own pipe. fifo_path moves it.
fifo         = off
fifo_path    =
# A password before anything shows, in the terminal and the webchat: at startup,
# on every attach and after /lock. /lock sets it the first time (it's stored
# hashed here), /lock on changes it, /lock off turns it off.
lock = off
#lock_password_hash =
# Lock by itself after this many minutes without typing (0 = never)
lock_idle = 0
# /shell checks the login and password with this PAM service
#pam_service = login

# Ask before sending a paste (or /exec -o output) longer than this many lines (0 = never ask).
# Servers with IRCv3 draft/multiline get a paste as one message.
paste_confirm = 5

# Tab (and a tapped suggestion in the webchat on phones) completing a nick at the start of
# a line adds this and a space: "bob: hi". E.g. , for "bob, hi"; off for just "bob hi".
complete_suffix = :

# Tell the others in a channel or query that you're typing (IRCv3 +typing):
# "bob is typing..." on their side. Theirs always shows in the status bar.
send_typing = on

# Away by yourself when idle or detached: the autoaway plugin (/plugin install autoaway).
# Plugins keep their settings in [plugin.<name>] sections: /help plugin

# On join, fetch what was said since the last line you have, from servers with
# IRCv3 chathistory (max 500, 0 = off).
history_fetch = 100

# CTCP answers (at most one reply every 2s per server, against floods).
# VERSION says e.g. "iSekur 0.5 :: Linux 6.8.0/x86_64 :: ... :: <github link>".
ctcp_version = on
ctcp_time    = on
ctcp_ping    = on

# DCC file transfers: off drops offers people send you and turns off
# /dcc get and /dcc send, on every network.
dcc     = on
# Files sent to you (DCC SEND) wait for /dcc get, then download here; the
# status bar shows the progress. On a VPS that's the VPS's disk.
dcc_dir = ~/Downloads
# /dcc send: the address offered (empty: the one the IRC connection uses) and
# the ports to listen on (empty: any). Behind a router: your public address,
# and forward those ports to this machine.
dcc_ip    =
dcc_ports =               ; e.g. 5000-5010
# The webchat's Files window downloads what's in dcc_dir (a seedbox).
dcc_web   = off

# One [server.<name>] section per network. All of them connect at startup
# unless autoconnect = false.
[server.sekurnet]
host      = irc.sekurnet.org
port      = 6697                ; empty or 0: 6697 with tls, 6667 without
tls       = true
tls_verify = true            ; false only for self-signed test servers
autojoin  = #isekur-test     ; #a,#b,#private key  (/autojoin add|del edits it)
hilight_words =              ; this network only, besides your nick: whole words, any case, * globs: isekur ger*
ignore    =                  ; this network only: spammer!*@* *!*@*.bad.host, or /ignore and /save
mute      =                  ; channels here that never hilight or alert: #busy #bots (/mute or the tab's menu)
notify    =                  ; nicks to watch: "bob is online" / "went offline" (/notify add|del, MONITOR or ISON)
; send_typing = off          ; this network's own +typing choice (default: the one in [general])
; sasl_pass, password and nickserv_pass are saved as enc:... (key in secret.key next to this file);
; type one in plain and iSekur encrypts it on the next start or /reload
; auto_identify = true     ; log in with SASL / NickServ on connect and reconnect (false: /msg NickServ yourself)
; encoding = iso-8859-9   ; this network's legacy charset, any iconv name (Turkish here); empty: UTF-8
; sasl_user = mynick
; sasl_pass = secret
; sasl_mech = PLAIN          ; PLAIN | SCRAM-SHA-256 | EXTERNAL (default: PLAIN, or EXTERNAL with cert)
; cert      = /path/client.pem  ; client certificate for SASL EXTERNAL / CertFP
; key       = /path/client.key  ; its private key, when it isn't in the cert file
; password  = server-password  ; bouncers: ZNC me/network:pass, psyBNC/sBNC the user password
; nickserv_pass = secret     ; /msg NickServ IDENTIFY on connect, for networks without SASL
; e2e_keys  =                ; written by /e2e #chan for autojoin channels (the key, not the password)

# Twitch chat is IRC too: the password is an OAuth token (chat:read chat:edit),
# "oauth:" is added if you leave it out; /twitch token shows how to get one.
# Channels are streamer names: #name for twitch.tv/name.
; [server.twitch]
; host      = irc.chat.twitch.tv
; port      = 6697
; tls       = true
; nick      = yourlogin
; password  = oauth:yourtoken
; autojoin  = #somestreamer

[server.local]
host      = 127.0.0.1
port      = 6667
autoconnect = false

# Built-in webchat: open the same session from a browser.
# HTTPS is mandatory unless bound to localhost; without cert/key a self-signed
# certificate is generated next to this file on first run.
# autostart = off (default): start it when needed with /web start, or launch
# with --web; /web stop turns it off. --daemon always starts it.
[web]
autostart     = off
bind          = 127.0.0.1
port          = 8443         ; empty or 0: 8443
user          = me
password_hash =              ; run: isekur --hash-password
cert          =              ; e.g. /path/fullchain.pem (empty: self-signed)
key           =              ; e.g. /path/privkey.pem
html          =              ; serve this file as the webchat page, re-read on every load,
                             ; e.g. ~/src/iSekur/web/index.html (empty: the built-in one)
tls           = auto         ; auto: HTTPS unless bound to localhost; true: HTTPS on localhost too

# Built-in BNC (bouncer): your other IRC clients (irssi, weechat, hexchat, mIRC...)
# connect here and share this session: the same networks, channels and recent lines.
# Log in with the server password user/network:password, e.g. me/sekurnet:secret
# (with one network, me:secret is enough). Set the password with /bnc password.
# autostart = on starts it with iSekur; else /bnc start, or run isekur --bnc
# (in the background, no terminal or webchat). /bnc status shows who is on.
# A bnc.motd file next to this config is the clients' MOTD (read at each login).
[bnc]
autostart     = off
bind          = 127.0.0.1    ; 0.0.0.0 or :: for every address
port          = 6698         ; empty or 0: 6698
tls           = on           ; off: plain IRC (keep that to 127.0.0.1)
user          = me
password_hash =              ; /bnc password sets it (or isekur --hash-password)
cert          =              ; e.g. /path/fullchain.pem (empty: self-signed bnc.crt)
key           =              ; e.g. /path/privkey.pem
certfp        =              ; SHA-256 of a client certificate (comma-separated): it logs in with SASL EXTERNAL,
                             ; no password. Needs tls = on. Get it: openssl x509 -noout -fingerprint -sha256 -in client.pem
backlog       = 50           ; lines of each tab a client gets when it connects (0: none)

# Key bindings: <action> = <key> [key...]
# Keys: M-x (Alt), C-x (Ctrl), F1-F12, PgUp, PgDn, Left/Right/Up/Down (M-Right...).
# Actions: next_tab prev_tab next_active next_server prev_server close_tab scroll_up
#          scroll_down toggle_nicklist toggle_topic detach toggle_mouse other_pane find_tab
#          quit (asks first) keys (the key list, F1 M-k)
#          tab_1 .. tab_10
[keys]
; The defaults are shown. Uncomment a line to change that action's keys (or /set keys.next_tab "M-Right C-n").
; next_tab = M-Down C-n
; prev_tab = M-Up C-p
; next_server = M-Right C-x
; prev_server = M-Left
; next_active = C-a M-a
; close_tab = C-w
; find_tab = C-g M-j
; other_pane = F6 M-o
; tab_1 = M-1
; tab_2 = M-2
; tab_3 = M-3
; tab_4 = M-4
; tab_5 = M-5
; tab_6 = M-6
; tab_7 = M-7
; tab_8 = M-8
; tab_9 = M-9
; tab_10 = M-0
; scroll_up = PgUp
; scroll_down = PgDn
; toggle_nicklist = C-l M-l F2
; toggle_topic = C-t M-t
; toggle_mouse = F3
; keys = F1 M-k
; lock = M-s
; detach = M-d C-z
; quit = M-q
