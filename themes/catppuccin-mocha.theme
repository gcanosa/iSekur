# Catppuccin Mocha. /theme catppuccin-mocha
[colors]
default        = #cdd6f4 #1e1e2e
topic          = #cdd6f4 #313244 bold
tabbar         = #6c7086 #181825
tab_server     = #cba6f7 #181825 bold
tab_home       = #94e2d5 #181825 bold
tab_shell      = #fab387 #181825 bold
tab_active     = #181825 #cba6f7 bold
tab_data       = #89b4fa #181825
tab_msg        = #cdd6f4 #181825 bold
tab_hilight    = #f5c2e7 #181825 bold
tab_quiet      = #6c7086 #181825 italic
tab_quiet_act  = #181825 #6c7086 bold
status         = #6c7086 #181825
status_hi      = #cdd6f4 #181825
status_info    = #cdd6f4 #181825
status_ok      = #a6e3a1
status_warn    = #f9e2af
status_high    = #fab387
status_crit    = #f38ba8 bold
status_bat     = #6c7086 #313244
input          = #cdd6f4 #1e1e2e
input_prompt   = #cba6f7 #1e1e2e bold
set_key        = #cba6f7 #1e1e2e bold
set_value      = #f9e2af #1e1e2e
timestamp      = #6c7086 #1e1e2e
separator      = #313244 #1e1e2e
nicklist       = #bac2de #1e1e2e
nicklist_title = #6c7086 #1e1e2e italic
nicklist_border= #313244 #1e1e2e
nicklist_op    = #fab387 #1e1e2e bold
nicklist_voice = #a6e3a1 #1e1e2e
menu           = #cdd6f4 #181825
menu_sel       = #181825 #cba6f7 bold
menu_border    = #313244 #181825
msg_self       = #89b4fa #1e1e2e bold
marker         = #f5c2e7
hilight        = #1e1e2e #f5c2e7 bold
hilight_text   = #f5c2e7 #1e1e2e
join           = #a6e3a1 #1e1e2e
part           = #fab387 #1e1e2e
quit           = #f38ba8 #1e1e2e
notice         = #f9e2af #1e1e2e bold
action         = #cba6f7 #1e1e2e italic
info           = #94e2d5 #1e1e2e
error          = #f38ba8 #1e1e2e bold

[nicks]
palette = #f38ba8 #fab387 #f9e2af #a6e3a1 #94e2d5 #89b4fa #cba6f7 #f5c2e7

[layout]
nicklist       = on
nicklist_width = 18
nick_width     = 12
separator      = │
timestamp      = %H:%M
