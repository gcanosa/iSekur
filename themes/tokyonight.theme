# Tokyo Night. /theme tokyonight
[colors]
default        = #c0caf5 #1a1b26
topic          = #c0caf5 #292e42 bold
tabbar         = #565f89 #16161e
tab_server     = #bb9af7 #16161e bold
tab_home       = #7dcfff #16161e bold
tab_shell      = #ff9e64 #16161e bold
tab_active     = #16161e #7aa2f7 bold
tab_data       = #7aa2f7 #16161e
tab_msg        = #c0caf5 #16161e bold
tab_hilight    = #ff007c #16161e bold
tab_quiet      = #565f89 #16161e italic
tab_quiet_act  = #16161e #565f89 bold
status         = #565f89 #16161e
status_hi      = #c0caf5 #16161e
status_info    = #c0caf5 #16161e
status_ok      = #9ece6a
status_warn    = #e0af68
status_high    = #ff9e64
status_crit    = #f7768e bold
status_bat     = #565f89 #292e42
input          = #c0caf5 #1a1b26
input_prompt   = #7aa2f7 #1a1b26 bold
set_key        = #7aa2f7 #1a1b26 bold
set_value      = #e0af68 #1a1b26
timestamp      = #565f89 #1a1b26
separator      = #292e42 #1a1b26
nicklist       = #a9b1d6 #1a1b26
nicklist_title = #565f89 #1a1b26 italic
nicklist_border= #292e42 #1a1b26
nicklist_op    = #ff9e64 #1a1b26 bold
nicklist_voice = #9ece6a #1a1b26
menu           = #c0caf5 #16161e
menu_sel       = #16161e #7aa2f7 bold
menu_border    = #292e42 #16161e
msg_self       = #7dcfff #1a1b26 bold
marker         = #ff007c
hilight        = #1a1b26 #ff007c bold
hilight_text   = #ff007c #1a1b26
join           = #9ece6a #1a1b26
part           = #ff9e64 #1a1b26
quit           = #f7768e #1a1b26
notice         = #e0af68 #1a1b26 bold
action         = #bb9af7 #1a1b26 italic
info           = #7dcfff #1a1b26
error          = #f7768e #1a1b26 bold

[nicks]
palette = #f7768e #ff9e64 #e0af68 #9ece6a #7dcfff #7aa2f7 #bb9af7 #ff007c

[layout]
nicklist       = on
nicklist_width = 18
nick_width     = 12
separator      = │
timestamp      = %H:%M
